{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process SOPS version in dccd.sh",
      managerFilePatterns: ["/scripts/dccd\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\nSOPS_VERSION=\"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process tool versions in GitHub Actions workflows",
      managerFilePatterns: [
        "/.github/workflows/.+\\.ya?ml$/",
        "/workflow-templates/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[\\w-]*version: \"?(?<currentValue>[^\\s\"]+)\"?",
      ],
      datasourceTemplate: "{{{datasource}}}",
    },
    {
      // Container images pinned by digest in GitHub Actions workflows. Annotate
      // the image line with a Renovate comment, e.g.:
      //   # renovate: datasource=docker depName=mcr.microsoft.com/devcontainers/base
      //   source: "mcr.microsoft.com/devcontainers/base:debian-12@sha256:..."
      // The key (source:, image:, etc.) is irrelevant; both the tag and the
      // digest are kept up to date.
      customType: "regex",
      description: "Process digest-pinned container images in GitHub Actions workflows",
      managerFilePatterns: [
        "/.github/workflows/.+\\.ya?ml$/",
        "/workflow-templates/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[\\w-]+:\\s*\"?[^\\s\"@]+:(?<currentValue>[^\\s\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?",
      ],
      datasourceTemplate: "{{{datasource}}}",
    },
    {
      customType: "regex",
      description: "Process min_version in .mise.toml",
      managerFilePatterns: ["/\\.mise\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\nmin_version = \"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process versions in Ansible inventory YAML files",
      managerFilePatterns: [
        "/ansible/inventory/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\n\\s*[\\w-]*version:\\s*\"?(?<currentValue>[^\\s\"]+)\"?",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Update DevSecNinja/dotfiles log.sh release pin",
      managerFilePatterns: ["/(^|/)scripts/lib/log\\.sh$/", "/\\.sh$/", "/\\.sh\\.tmpl$/"],
      matchStrings: [
        "DevSecNinja/dotfiles/releases/download/(?<currentValue>v[^/]+)/log\\.sh",
      ],
      depNameTemplate: "DevSecNinja/dotfiles",
      datasourceTemplate: "github-releases",
    },
    {
      // Maintain the tag pins of APM package dependencies in apm.yml, e.g.:
      //   dependencies:
      //     apm:
      //     - DevSecNinja/ai-toolkit#v0.1.1
      // Renovate bumps the `#vX.Y.Z` ref to the latest GitHub tag of the
      // referenced owner/repo. The companion `apm-materialize.yml` workflow then
      // runs `apm install` on the PR to refresh apm.lock.yaml and redeploy the
      // primitives (Mend-hosted Renovate cannot run that postUpgrade itself).
      customType: "regex",
      description: "Process APM package tag pins in apm.yml",
      managerFilePatterns: ["/(^|/)apm\\.yml$/"],
      matchStrings: [
        "-\\s+(?<depName>[^#\\s]+/[^#\\s]+)#(?<currentValue>v[0-9][^\\s]*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // Track the minimum chezmoi version pinned in .chezmoiversion against
      // upstream chezmoi releases. The file contains a single bare version
      // (e.g. "2.69.1"); upstream tags are prefixed with "v", so strip it.
      customType: "regex",
      description: "Update minimum chezmoi version in .chezmoiversion",
      managerFilePatterns: ["/(^|/)\\.chezmoiversion$/"],
      matchStrings: ["^(?<currentValue>\\S+)\\s*$"],
      depNameTemplate: "twpayne/chezmoi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
  ],
}
