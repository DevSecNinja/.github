{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate's first-party annotation and schema managers. They live here, not
  // in default.json5, because most repositories still extend the individual
  // presets; each one only acts on repositories that have the files it targets:
  // - githubActionsVersions: `# renovate:` above an upper-case
  //   `<NAME>_VERSION:` key in workflows and action.yml (the lower-case
  //   `…version:` keys are the workflow manager below);
  // - biomeVersions: the `$schema` version in biome.json(c);
  // - makefileVersions: `# renovate:` above `<NAME>_VERSION ?=` in Makefiles.
  extends: [
    "customManagers:githubActionsVersions",
    "customManagers:biomeVersions",
    "customManagers:makefileVersions",
  ],
  customManagers: [
    {
      // Annotated versions in shell scripts (and chezmoi .tmpl copies), e.g.
      //   # renovate: datasource=github-releases depName=bats-core/bats-assert
      //   BATS_ASSERT_VERSION="v2.1.0"
      //   # renovate: datasource=docker depName=docker.io/library/postgres
      //   POSTGRES_IMAGE="docker.io/library/postgres:18.3-alpine@sha256:<64 hex>"
      // Optional packageName=, versioning=, extractVersion= and registryUrl=
      // follow depName= in that order, like Renovate's own *Versions presets.
      // An image value keeps its `<registry>[:port]/<path>/<name>:` prefix; only
      // the tag and digest are tracked, so images need a path
      // (`docker.io/library/redis:7.4`, not `redis:7.4`). Without a path a value
      // keeps a leading numeric Debian epoch (`5:29.6.2-1~…`). Three exclusive
      // patterns: double-quoted, single-quoted and unquoted values; each must end
      // at the quote or a command separator, so a value that is not a plain
      // literal (`"1.2.3 ${X}"`, `1.2.3$S`, a backtick substitution or a
      // backslash escape) is not matched. Replaces the truenas-apps-only SOPS
      // manager for scripts/dccd.sh, which this covers.
      customType: "regex",
      description: "Process annotated versions in shell scripts",
      managerFilePatterns: ["/\\.(?:sh|bash|zsh|bats)(?:\\.tmpl)?$/"],
      matchStrings: [
        "#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+packageName=(?<packageName>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+registryUrl=(?<registryUrl>\\S+))?[ \\t]*\\r?\\n[ \\t]*(?:(?:export|local|readonly|declare(?:[ \\t]+-[a-zA-Z]+)*)[ \\t]+)?[A-Za-z_][A-Za-z0-9_]*=\"(?:[^\\s\"'@$;`\\\\]*/[^\\s\"'@$;`\\\\/]*:)?(?<currentValue>(?:[0-9]+:)?[A-Za-z0-9][^\\s\"'@$;`\\\\:/]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"(?:[ \\t;&|]|\\r?\\n|$)",
        "#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+packageName=(?<packageName>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+registryUrl=(?<registryUrl>\\S+))?[ \\t]*\\r?\\n[ \\t]*(?:(?:export|local|readonly|declare(?:[ \\t]+-[a-zA-Z]+)*)[ \\t]+)?[A-Za-z_][A-Za-z0-9_]*='(?:[^\\s\"'@$;]*/[^\\s\"'@$;/]*:)?(?<currentValue>(?:[0-9]+:)?[A-Za-z0-9][^\\s\"'@$;:/]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?'(?:[ \\t;&|]|\\r?\\n|$)",
        "#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+packageName=(?<packageName>\\S+))?(?:[ \\t]+versioning=(?<versioning>\\S+))?(?:[ \\t]+extractVersion=(?<extractVersion>\\S+))?(?:[ \\t]+registryUrl=(?<registryUrl>\\S+))?[ \\t]*\\r?\\n[ \\t]*(?:(?:export|local|readonly|declare(?:[ \\t]+-[a-zA-Z]+)*)[ \\t]+)?[A-Za-z_][A-Za-z0-9_]*=(?:[^\\s\"'@$;`&|<>()#\\\\]*/[^\\s\"'@$;`&|<>()#\\\\/]*:)?(?<currentValue>(?:[0-9]+:)?[A-Za-z0-9][^\\s\"'@$;`&|<>()#\\\\:/]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?(?:[ \\t;&|]|\\r?\\n|$)",
      ],
      datasourceTemplate: "{{{datasource}}}",
      // No versioningTemplate: Renovate then takes `versioning=` from the
      // annotation, or the datasource's default (`docker` for images, which
      // keeps a `-alpine` suffix). A template that renders empty would force
      // semver-coerced instead.
    },
    {
      customType: "regex",
      description: "Process tool versions in GitHub Actions workflows",
      managerFilePatterns: [
        "/.github/workflows/.+\\.ya?ml$/",
        "/workflow-templates/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+)(?: depName=(?<depName>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?\\r?\\n\\s+[\\w-]*version: \\[?\"?(?<currentValue>[^\\s\"\\[\\],]+)\"?\\]?[ \\t]*(?:#[^\\n]*)?(?:\\r?\\n|$)",
      ],
      datasourceTemplate: "{{{datasource}}}",
      // `depName=` may be omitted for the runtime datasources, e.g.
      //   # renovate: datasource=python-version
      //   python-version: [3.14]
      // and `registryUrl=` names a registry other than the datasource's
      // default, e.g. the PowerShell Gallery for a module:
      //   # renovate: datasource=nuget depName=PSScriptAnalyzer registryUrl=https://www.powershellgallery.com/api/v2/
      //   psscriptanalyzer-version: "1.25.0"
      // A single-element matrix list is tracked like a scalar; a list with
      // more entries is not tracked at all (the match must end the line;
      // Renovate's RE2 engine has no lookahead, so the line end is consumed). Without
      // depName, the name is the datasource minus `-version` (python, node).
      depNameTemplate: "{{#if depName}}{{{depName}}}{{else}}{{{replace '-version$' '' datasource}}}{{/if}}",
    },
    {
      // Container images pinned by digest in GitHub Actions workflows. Annotate
      // the image line with a Renovate comment, e.g.:
      //   # renovate: datasource=docker depName=mcr.microsoft.com/devcontainers/base
      //   source: "mcr.microsoft.com/devcontainers/base:debian-12@sha256:..."
      // The key (source:, image:, etc.) is irrelevant; both the tag and the
      // digest are kept up to date.
      customType: "regex",
      description: "Process digest-pinned container images in GitHub Actions workflows",
      managerFilePatterns: [
        "/.github/workflows/.+\\.ya?ml$/",
        "/workflow-templates/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\r?\\n\\s+[\\w-]+:\\s*\"?[^\\s\"@]+:(?<currentValue>[^\\s\"@]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?",
      ],
      datasourceTemplate: "{{{datasource}}}",
    },
    {
      customType: "regex",
      description: "Process min_version in .mise.toml",
      managerFilePatterns: ["/\\.mise\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=github-releases depName=(?<depName>\\S+)\\r?\\nmin_version = \"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      description: "Process versions in Ansible inventory YAML files",
      managerFilePatterns: [
        "/ansible/inventory/.+\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?[ \\t]*\\r?\\n\\s*[\\w-]+:\\s*\"?(?<currentValue>[^\\s\"]+)\"?",
      ],
      // Any datasource, with an optional registryUrl, and any key on the next
      // line: the annotation marks the value. For example, Debian packages
      // pinned per suite and architecture (deb defaults to deb versioning):
      //   # renovate: datasource=deb depName=docker-ce registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
      //   docker_ce: "5:29.6.2-1~debian.13~trixie"
      datasourceTemplate: "{{{datasource}}}",
    },
    {
      customType: "regex",
      description: "Update DevSecNinja/dotfiles log.sh release pin",
      managerFilePatterns: ["/(^|/)scripts/lib/log\\.sh$/", "/\\.sh$/", "/\\.sh\\.tmpl$/"],
      matchStrings: [
        "DevSecNinja/dotfiles/releases/download/(?<currentValue>v[^/]+)/log\\.sh",
      ],
      depNameTemplate: "DevSecNinja/dotfiles",
      datasourceTemplate: "github-releases",
    },
    {
      // Maintain the tag pins of APM package dependencies in apm.yml, e.g.:
      //   dependencies:
      //     apm:
      //     - DevSecNinja/ai-toolkit#v0.1.1
      //     - DevSecNinja/ai-toolkit/.apm/skills/some-skill#v0.1.1
      // Renovate bumps the `#vX.Y.Z` ref to the latest GitHub tag of the
      // referenced owner/repo; a subpath pin is looked up by its owner/repo.
      // Post-merge, the `apm-materialize.yml` workflow runs `apm install` to
      // refresh apm.lock.yaml and redeploy the primitives (Mend-hosted Renovate
      // cannot run that postUpgrade itself).
      customType: "regex",
      description: "Process APM package tag pins in apm.yml",
      managerFilePatterns: ["/(^|/)apm\\.yml$/"],
      matchStrings: [
        "-\\s+(?<depName>[^#\\s/]+/[^#\\s/]+)(?:/[^#\\s]*)?#(?<currentValue>v[0-9][^\\s]*)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      // Track the minimum chezmoi version pinned in .chezmoiversion against
      // upstream chezmoi releases. The file contains a single bare version
      // (e.g. "2.69.1"); upstream tags are prefixed with "v", so strip it.
      customType: "regex",
      description: "Update minimum chezmoi version in .chezmoiversion",
      managerFilePatterns: ["/(^|/)\\.chezmoiversion$/"],
      matchStrings: ["^(?<currentValue>\\S+)\\s*$"],
      depNameTemplate: "twpayne/chezmoi",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      // dprint plugin URLs in dprint.json, e.g.
      //   "https://plugins.dprint.dev/markdown-0.21.1.wasm"
      // Renovate has no dprint manager. Official plugins are released as
      // dprint/dprint-plugin-<name> with bare tags (0.21.1). Same approach as
      // kachick/renovate-config-dprint, kept here so the fleet doesn't depend
      // on a third-party preset. Process plugins (`.json@<checksum>`) are not
      // matched.
      customType: "regex",
      description: "Update official dprint plugin URLs in dprint.json",
      managerFilePatterns: ["/(^|/)\\.?dprint\\.jsonc?$/"],
      matchStrings: [
        "\"https://plugins\\.dprint\\.dev/(?<plugin>[a-z0-9_]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm\"",
      ],
      depNameTemplate: "dprint/dprint-plugin-{{{plugin}}}",
      datasourceTemplate: "github-releases",
      depTypeTemplate: "dprint-plugin",
    },
    {
      // Third-party dprint plugins are served under the author's name and
      // released from the GitHub repository of the same name with v-prefixed
      // tags, e.g.
      //   "https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm"  (g-plane/malva v0.16.0)
      customType: "regex",
      description: "Update third-party dprint plugin URLs in dprint.json",
      managerFilePatterns: ["/(^|/)\\.?dprint\\.jsonc?$/"],
      matchStrings: [
        "\"https://plugins\\.dprint\\.dev/(?<owner>[A-Za-z0-9-]+)/(?<repo>[A-Za-z0-9_.-]+?)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm\"",
      ],
      depNameTemplate: "{{{owner}}}/{{{repo}}}",
      datasourceTemplate: "github-releases",
      depTypeTemplate: "dprint-plugin",
    },
  ],
}
