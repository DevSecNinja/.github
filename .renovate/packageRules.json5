{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest-only updates — reduces PR noise and avoids auto-merging potentially hijacked tags (see Trivy CVE-2026-33634)",
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      description: "Enable digest updates for DevSecNinja devcontainer images",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["/^ghcr\\.io\\/devsecninja\\//"],
      matchUpdateTypes: ["digest"],
      enabled: true,
      minimumReleaseAge: "0",
    },
    {
      description: "Auto-merge dotfiles devcontainer image updates via branch without tests",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["ghcr.io/devsecninja/dotfiles-devcontainer"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      minimumReleaseAge: "0",
    },
    {
      description: "Disable Docker lookups for official Dev Container feature references",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["feature"],
      matchPackageNames: ["/^ghcr\\.io\\/devcontainers\\/features\\//"],
      enabled: false,
    },
    {
      description: "Flag dependencies where the currently-used version is over 1 year old — likely abandoned or unmaintained.",
      matchCurrentAge: "> 1 year",
      addLabels: ["stale-dependency"],
    },
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      matchManagers: ["mise"],
      minimumReleaseAge: "14 days",
      pinDigests: false,
    },
    {
      matchDatasources: ["github-releases"],
      minimumReleaseAge: "14 days",
    },
    {
      matchDatasources: ["docker"],
      minimumReleaseAge: "14 days",
    },
    {
      description: "Use custom versioning for linuxserver images",
      versioning: "regex:^(version)(?<compatibility>.*?)-(?<major>v?\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[\\.-]*r?(?<build>\\d+)*-*r?(?<release>\\w+)|^latest*",
      matchPackageNames: ["/^lscr\\.io\\/linuxserver\\//"],
    },
  ],
}
