{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest-only updates — reduces PR noise and avoids auto-merging potentially hijacked tags (see Trivy CVE-2026-33634)",
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      description: "Enable digest updates for DevSecNinja devcontainer images",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["/^ghcr\\.io\\/devsecninja\\//"],
      matchUpdateTypes: ["digest"],
      enabled: true,
      minimumReleaseAge: "0",
    },
    {
      // `uses: owner/repo@<sha> # main` tracks a branch: there is no tag to
      // move to, so a digest update is the only way the pin ever advances.
      // The digest disable above froze these pins (DevSecNinja/dotfiles was
      // 500+ commits behind). The hijacked-tag risk behind that disable does
      // not apply: a branch pin is meant to follow the branch head. Branch
      // heads may carry no release timestamp, so a missing one does not leave
      // the update pending forever; when one exists, the 14-day soak applies.
      description: "Re-enable digest updates for GitHub Actions pinned to a branch (# main / # master); a branch pin can only move by digest",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^(main|master)$/",
      enabled: true,
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // DevSecNinja branch pins keep automerge from autoMerge.json5 and join
      // the weekly non-major batch. Third-party branch heads are unreleased
      // code, so they get their own PR (groupName null keeps the weekly batch
      // automerging) and wait for owner review. Renovate cannot remove the
      // `merge: auto` label that autoMerge.json5 adds; `automerge: false` wins.
      description: "Third-party actions pinned to a branch need owner review: own PR, no automerge",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^(main|master)$/",
      matchPackageNames: ["!DevSecNinja/**"],
      automerge: false,
      groupName: null,
      commitMessageSuffix: "",
      addLabels: ["merge: manual"],
    },
    {
      description: "Disable Docker lookups for official Dev Container feature references",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["feature"],
      matchPackageNames: ["/^ghcr\\.io\\/devcontainers\\/features\\//"],
      enabled: false,
    },
    {
      description: "Flag dependencies where the currently-used version is over 1 year old — likely abandoned or unmaintained.",
      matchCurrentAge: "> 1 year",
      addLabels: ["stale-dependency"],
    },
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      matchManagers: ["mise"],
      minimumReleaseAge: "14 days",
      pinDigests: false,
    },
    {
      description: "npm engines declare the supported range; .mise.toml pins the exact development and CI version. Replace the range on a new major, never pin it.",
      matchManagers: ["npm"],
      matchDepTypes: ["engines"],
      rangeStrategy: "replace",
    },
    {
      description: "The node-version datasource returns versions with a leading \"v\" (e.g. v24.17.0), but mise expects them without it (24.17.0). Strip the prefix so pinning .mise.toml produces valid versions.",
      matchManagers: ["mise"],
      matchDepNames: ["node"],
      extractVersion: "^v?(?<version>.+)$",
    },
    {
      description: "Regex custom managers track bare versions (e.g. 2026.10.19) against v-prefixed github-releases tags. A digest cannot be resolved for the non-existent bare tag (\"Could not determine new digest\"), so disable digest pinning for them.",
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-releases"],
      pinDigests: false,
    },
    {
      matchDatasources: ["github-releases"],
      minimumReleaseAge: "14 days",
    },
    {
      matchDatasources: ["docker"],
      minimumReleaseAge: "14 days",
    },
    {
      // Renovate only derives a release timestamp for Docker Hub, and only via
      // the Hub-specific hub.docker.com API — `registryHost === DOCKER_HUB` in
      // the docker datasource. Every other registry goes through the OCI
      // Registry V2 /tags/list endpoint, which returns bare tag names, so no
      // timestamp exists regardless of what the registry stores internally.
      // Match that condition directly instead of maintaining an allowlist:
      // previously each new registry had to be remembered here AND in the
      // cooldown workflow, and dhi.io was missing from both for ~3.5 months
      // (DevSecNinja/truenas-apps#634).
      // The positive pattern requires a dot in the first path segment, i.e. an
      // explicit registry host, so bare Docker Hub names like "nginx" or
      // "library/nginx" keep their native soak.
      // The same matcher also stamps the branch name, so the cooldown gate and
      // this rule can never disagree: any dep Renovate cannot soak natively
      // gets `renovate/docker-gated-`, and the workflow gates exactly that
      // prefix. A registry nobody has wired up yet is therefore gated by
      // default rather than auto-merging unsoaked.
      // `groupName: null` keeps each gated dependency on its own branch, out
      // of the weekly all-non-major group (groups.json5): a shared branch would
      // lose the `docker-gated-` prefix — so pr-cooldown would not gate it and
      // it would auto-merge with no soak at all — and every new release of any
      // grouped dependency would reset the cooldown clock.
      description: "Every registry except Docker Hub lacks a trusted release timestamp, so the default timestamp-required behaviour marks every release 'pending' forever and no PR is ever created. Treat missing timestamps as stable so Renovate opens the PR (and enables automerge); the 14-day soak is instead enforced by the pr-cooldown required status check, which measures the PR branch head commit age. rebaseWhen:conflicted (an exception to the global rebaseWhen:auto, ADR 0013) stops behind-base-branch rebases from rewriting that commit on every base change and perpetually resetting the cooldown clock. A behind-base gated PR therefore only auto-merges where branch protection does not require branches to be up to date, so repositories that require pr-cooldown keep that setting off. groupName:null keeps each gated dependency out of the weekly non-major group so it keeps its own docker-gated- branch and cooldown clock. Placed after the generic docker rule so it wins. See docs/design-decisions/0005-pr-age-cooldown-for-untrusted-timestamps.md.",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/^[^/]*\\./",
        "!/^docker\\.io\\//",
      ],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      rebaseWhen: "conflicted",
      additionalBranchPrefix: "docker-gated-",
      groupName: null,
    },
    {
      description: "Auto-merge dotfiles devcontainer image digest, patch, and minor updates via branch without tests, ignoring the global schedule and release-age soak so they can always merge. Kept out of the weekly non-major group (groupName:null) so it keeps its own at-any-time branch. The image is on ghcr.io, so it also matches the docker-gated rule above; rebaseWhen:auto undoes that rule's conflicted, because branch automerge needs the branch rebased once main moves (otherwise Renovate raises a PR instead, ADR 0013). Placed after the generic docker minimumReleaseAge rule so its minimumReleaseAge:0 wins. Major bumps are intentionally excluded and left for manual review.",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["ghcr.io/devsecninja/dotfiles-devcontainer"],
      matchUpdateTypes: ["digest", "patch", "minor"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      minimumReleaseAge: "0",
      schedule: ["at any time"],
      groupName: null,
      rebaseWhen: "auto",
    },
    {
      // The `v` prefix is matched outside `<major>`: capturing it (`v?\d+`) makes
      // Renovate's Number.parseInt("v1") return NaN and corrupt version comparison.
      // `<release>` is optional so three-part tags with no trailing build/release
      // segment (e.g. bazarr's `version-v1.5.3`) match at all — when it was
      // mandatory those tags never matched and were never updated, and tags like
      // `version-10.4.57` backtracked into patch=5/release=7. `latest` is anchored
      // with `$` so it cannot also match unrelated tags sharing that prefix.
      description: "Use custom versioning for linuxserver images",
      versioning: "regex:^(version)(?<compatibility>.*?)-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[\\.-]*r?(?<build>\\d+)*-*r?(?<release>\\w+)?|^latest$",
      // linuxserver publishes the same images to Docker Hub, lscr.io and ghcr.io
      // with identical digests. Docker Hub is preferred because it is the only
      // registry Renovate reads a release timestamp from, so the soak is
      // enforced natively there rather than by the pr-cooldown proxy — but the
      // rule must cover every mirror, otherwise moving an image between them
      // silently changes its versioning.
      matchPackageNames: [
        "/^lscr\\.io\\/linuxserver\\//",
        "/^docker\\.io\\/linuxserver\\//",
        "/^ghcr\\.io\\/linuxserver\\//",
      ],
      // Only `version-*` tags need this regex. Some linuxserver images (e.g.
      // qbittorrent) publish plain semver tags like `5.1.4`, which the regex
      // cannot parse — forcing it on them makes the value uncomparable, so they
      // get digest-only updates and silently freeze. Selecting on tag shape
      // instead of image name lets those fall through to default docker
      // versioning, which compares them correctly, with no per-image allowlist.
      matchCurrentValue: "/^version-/",
    },
  ],
}
