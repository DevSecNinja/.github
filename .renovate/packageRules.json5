{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable digest-only updates — reduces PR noise and avoids auto-merging potentially hijacked tags (see Trivy CVE-2026-33634)",
      matchUpdateTypes: ["digest"],
      enabled: false,
    },
    {
      description: "Enable digest updates for DevSecNinja devcontainer images",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["/^ghcr\\.io\\/devsecninja\\//"],
      matchUpdateTypes: ["digest"],
      enabled: true,
      minimumReleaseAge: "0",
    },
    {
      // `uses: owner/repo@<sha> # main` tracks a branch: there is no tag to
      // move to, so a digest update is the only way the pin ever advances.
      // The digest disable above froze these pins (DevSecNinja/dotfiles was
      // 500+ commits behind). The hijacked-tag risk behind that disable does
      // not apply: a branch pin is meant to follow the branch head. Branch
      // heads may carry no release timestamp, so a missing one does not leave
      // the update pending forever; when one exists, the 14-day soak applies.
      description: "Re-enable digest updates for GitHub Actions pinned to a branch (# main / # master); a branch pin can only move by digest",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^(main|master)$/",
      enabled: true,
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // DevSecNinja branch pins keep automerge from autoMerge.json5 and join
      // the weekly non-major batch. Third-party branch heads are unreleased
      // code, so they get their own PR (groupName null keeps the weekly batch
      // automerging) and wait for owner review. Renovate cannot remove the
      // `merge: auto` label that autoMerge.json5 adds; `automerge: false` wins.
      description: "Third-party actions pinned to a branch need owner review: own PR, no automerge",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["digest"],
      matchCurrentValue: "/^(main|master)$/",
      matchPackageNames: ["!DevSecNinja/**"],
      automerge: false,
      groupName: null,
      commitMessageSuffix: "",
      addLabels: ["merge: manual"],
    },
    {
      description: "Disable Docker lookups for official Dev Container feature references",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["feature"],
      matchPackageNames: ["/^ghcr\\.io\\/devcontainers\\/features\\//"],
      enabled: false,
    },
    {
      description: "Flag dependencies where the currently-used version is over 1 year old — likely abandoned or unmaintained.",
      matchCurrentAge: "> 1 year",
      addLabels: ["stale-dependency"],
    },
    // Known-stable packages that Renovate's abandonment check (1 year without
    // a release, from abandonments:recommended in config:recommended) flags as
    // false positives. One central list instead of the same rule in every
    // repository that uses the package. Same shape as Renovate's own
    // community overrides; add a reason for every entry.
    {
      // Feature-complete and part of the Testing Library org; releases are
      // rare because the API is stable (DevSecNinja/grip-visualizer).
      description: "Known-stable npm package: not abandoned despite infrequent releases",
      matchDatasources: ["npm"],
      matchPackageNames: ["@testing-library/user-event"],
      abandonmentThreshold: "5 years",
    },
    {
      // The current, required timer-trigger extension of the Azure Functions
      // isolated worker; Microsoft releases it infrequently
      // (DevSecNinja/az-vm-start-stop).
      description: "Known-stable NuGet package: not abandoned despite infrequent releases",
      matchDatasources: ["nuget"],
      matchPackageNames: ["Microsoft.Azure.Functions.Worker.Extensions.Timer"],
      abandonmentThreshold: "10 years",
    },
    {
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "14 days",
    },
    {
      // `runs-on: ubuntu-26.04` runs, but actionlint 1.7.12 (the latest
      // release) rejects the label as unknown, so every ubuntu v26 PR fails
      // `lint / actionlint` (rhysd/actionlint#682). Docker's apt repository
      // has no 26.04 packages yet either (DevSecNinja/docker#195). Only 26 is
      // held: a later runner release is proposed as usual. Drop this rule once
      // a Renovate bump of actionlint knows the label.
      description: "Hold ubuntu-26.04 runners until actionlint accepts the label",
      matchDatasources: ["github-runners"],
      matchPackageNames: ["ubuntu"],
      allowedVersions: "!/^26\\./",
    },
    {
      matchManagers: ["mise"],
      minimumReleaseAge: "14 days",
      pinDigests: false,
    },
    {
      description: "npm engines declare the supported range; .mise.toml pins the exact development and CI version. Replace the range on a new major, never pin it.",
      matchManagers: ["npm"],
      matchDepTypes: ["engines"],
      rangeStrategy: "replace",
    },
    {
      description: "Annotated python-version values in workflows (custom manager in customManagers.json5) declare a minor such as 3.14; replace it on a new release instead of pinning a patch",
      matchManagers: ["custom.regex"],
      matchDatasources: ["python-version"],
      rangeStrategy: "replace",
    },
    {
      description: "The node-version datasource returns versions with a leading \"v\" (e.g. v24.17.0), but mise expects them without it (24.17.0). Strip the prefix so pinning .mise.toml produces valid versions.",
      matchManagers: ["mise"],
      matchDepNames: ["node"],
      extractVersion: "^v?(?<version>.+)$",
    },
    {
      description: "Regex custom managers track bare versions (e.g. 2026.10.19) against v-prefixed github-releases tags. A digest cannot be resolved for the non-existent bare tag (\"Could not determine new digest\"), so disable digest pinning for them.",
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-releases"],
      pinDigests: false,
    },
    {
      // Renovate's apm manager reads apm.yml refs (`owner/repo/path#v0.9.1`)
      // and, with the global pinDigests, opened one "pin tag ... to <sha>" PR
      // per file. Mend-hosted Renovate can't run `apm install`, so
      // apm.lock.yaml is never refreshed and every pin PR fails
      // renovate/artifacts (DevSecNinja/az-vm-start-stop#158). apm.lock.yaml
      // already records the resolved commit of each tag.
      description: "APM refs in apm.yml stay on tags: apm.lock.yaml records the commit, and a digest pin can't refresh the lock",
      matchManagers: ["apm"],
      pinDigests: false,
    },
    {
      matchDatasources: ["github-releases"],
      minimumReleaseAge: "14 days",
    },
    {
      matchDatasources: ["docker"],
      minimumReleaseAge: "14 days",
    },
    {
      // Renovate only derives a release timestamp for Docker Hub, and only via
      // the Hub-specific hub.docker.com API — `registryHost === DOCKER_HUB` in
      // the docker datasource. Every other registry goes through the OCI
      // Registry V2 /tags/list endpoint, which returns bare tag names, so no
      // timestamp exists regardless of what the registry stores internally.
      // Match that condition directly instead of maintaining an allowlist:
      // previously each new registry had to be remembered here AND in the
      // cooldown workflow, and dhi.io was missing from both for ~3.5 months
      // (DevSecNinja/truenas-apps#634).
      // The positive pattern requires a dot in the first path segment, i.e. an
      // explicit registry host, so bare Docker Hub names like "nginx" or
      // "library/nginx" keep their native soak.
      // The same matcher also stamps the branch name, so the cooldown gate and
      // this rule can never disagree: any dep Renovate cannot soak natively
      // gets `renovate/docker-gated-`, and the workflow gates exactly that
      // prefix. A registry nobody has wired up yet is therefore gated by
      // default rather than auto-merging unsoaked.
      // `groupName: null` keeps each gated dependency on its own branch, out
      // of the weekly all-non-major group (groups.json5): a shared branch would
      // lose the `docker-gated-` prefix — so pr-cooldown would not gate it and
      // it would auto-merge with no soak at all — and every new release of any
      // grouped dependency would reset the cooldown clock.
      description: "Every registry except Docker Hub lacks a trusted release timestamp, so the default timestamp-required behaviour marks every release 'pending' forever and no PR is ever created. Treat missing timestamps as stable so Renovate opens the PR (and enables automerge); the 14-day soak is instead enforced by the pr-cooldown required status check, which measures how long the PR has proposed its current change (ADR 0005). rebaseWhen:conflicted (an exception to the global rebaseWhen:auto, ADR 0013) stops behind-base-branch rebases on every base change, which would cost a CI run each while the PR soaks. A behind-base gated PR therefore only auto-merges where branch protection does not require branches to be up to date, so repositories that require pr-cooldown keep that setting off. groupName:null keeps each gated dependency out of the weekly non-major group so it keeps its own docker-gated- branch and cooldown clock. Placed after the generic docker rule so it wins. See docs/design-decisions/0005-pr-age-cooldown-for-untrusted-timestamps.md.",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/^[^/]*\\./",
        "!/^docker\\.io\\//",
      ],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      rebaseWhen: "conflicted",
      additionalBranchPrefix: "docker-gated-",
      groupName: null,
    },
    {
      description: "Auto-merge dotfiles devcontainer image digest, patch, and minor updates via branch without tests, ignoring the global schedule and release-age soak so they can always merge. Kept out of the weekly non-major group (groupName:null) so it keeps its own at-any-time branch. The image is on ghcr.io, so it also matches the docker-gated rule above; rebaseWhen:auto undoes that rule's conflicted, because branch automerge needs the branch rebased once main moves (otherwise Renovate raises a PR instead, ADR 0013). Placed after the generic docker minimumReleaseAge rule so its minimumReleaseAge:0 wins. Major bumps are intentionally excluded and left for manual review.",
      matchManagers: ["devcontainer"],
      matchDatasources: ["docker"],
      matchDepTypes: ["image"],
      matchPackageNames: ["ghcr.io/devsecninja/dotfiles-devcontainer"],
      matchUpdateTypes: ["digest", "patch", "minor"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      minimumReleaseAge: "0",
      schedule: ["at any time"],
      groupName: null,
      rebaseWhen: "auto",
    },
    {
      // The `v` prefix is matched outside `<major>`: capturing it (`v?\d+`) makes
      // Renovate's Number.parseInt("v1") return NaN and corrupt version comparison.
      // `<release>` is optional so three-part tags with no trailing build/release
      // segment (e.g. bazarr's `version-v1.5.3`) match at all — when it was
      // mandatory those tags never matched and were never updated, and tags like
      // `version-10.4.57` backtracked into patch=5/release=7. `latest` is anchored
      // with `$` so it cannot also match unrelated tags sharing that prefix.
      description: "Use custom versioning for linuxserver images",
      versioning: "regex:^(version)(?<compatibility>.*?)-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)[\\.-]*r?(?<build>\\d+)*-*r?(?<release>\\w+)?|^latest$",
      // linuxserver publishes the same images to Docker Hub, lscr.io and ghcr.io
      // with identical digests. Docker Hub is preferred because it is the only
      // registry Renovate reads a release timestamp from, so the soak is
      // enforced natively there rather than by the pr-cooldown proxy — but the
      // rule must cover every mirror, otherwise moving an image between them
      // silently changes its versioning.
      matchPackageNames: [
        "/^lscr\\.io\\/linuxserver\\//",
        "/^docker\\.io\\/linuxserver\\//",
        "/^ghcr\\.io\\/linuxserver\\//",
      ],
      // Only `version-*` tags need this regex. Some linuxserver images (e.g.
      // qbittorrent) publish plain semver tags like `5.1.4`, which the regex
      // cannot parse — forcing it on them makes the value uncomparable, so they
      // get digest-only updates and silently freeze. Selecting on tag shape
      // instead of image name lets those fall through to default docker
      // versioning, which compares them correctly, with no per-image allowlist.
      matchCurrentValue: "/^version-/",
    },
    {
      // A dprint plugin update can change how Markdown is formatted, which
      // fails the repository's `lint / dprint` check until the files are
      // reformatted (markdown 0.21.1 -> 0.29.0 reformats files in four repos,
      // DevSecNinja/.github#560). In the weekly batch that would block every
      // other non-major update, so each plugin gets its own PR. It keeps the
      // github-releases soak and automerge.
      description: "dprint plugin updates (customManagers.json5) get their own PR so a formatting change cannot block the weekly batch",
      matchDepTypes: ["dprint-plugin"],
      groupName: null,
    },
    {
      // A pin only records the exact version or digest of what the repository
      // already uses (`v4` -> `v4.4.0`, `^6.12.0` -> `6.12.0`, `@main` ->
      // `@<sha> # main`), so there is no new code to soak. With the soak, a
      // single young version held the whole pin PR on
      // renovate/stability-days (DevSecNinja/funda-scorecard#67). Kept after
      // the per-datasource soak rules above so it wins. groupName null takes
      // pins out of the weekly batch and Renovate's own "Pin Dependencies"
      // group, so one slow pin cannot hold the others. Non-Docker-Hub images
      // keep their docker-gated- branch and pr-cooldown check (ADR 0005).
      description: "Pins (pin, pinDigest) fix the version already in use: no release-age soak, own PR, automerge",
      matchUpdateTypes: ["pin", "pinDigest"],
      minimumReleaseAge: "0",
      groupName: null,
      // Ungrouped, a pin is a group of one: undo minimumGroupSize from the
      // specific groups (postgres sets 2), or a lone pin never gets a branch.
      minimumGroupSize: 1,
      automerge: true,
    },
    {
      // Renovate applies packageRules after the lockFileMaintenance block
      // (base.json5), so a rule without matchUpdateTypes, such as the mise
      // 14-day soak above, also hits a lock refresh. A lock refresh has no
      // release timestamp, so under the default timestamp-required behaviour
      // its renovate/stability-days check stays pending forever and the
      // monthly branch never merges (DevSecNinja/.github#631,
      // renovatebot/renovate#45236). Kept last so no manager or datasource
      // rule can put the soak back. npm still applies its own 3-day
      // minimumReleaseAgePackageManager (config:best-practices) during the
      // refresh.
      description: "Lock file maintenance has no release timestamp: never hold it on a release-age soak",
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
  ],
}
