{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  pinDigests: true,
  rangeStrategy: "pin",
  minimumReleaseAge: "14 days",
  // Keep the strict default explicit: for datasources that DO expose a trusted
  // release timestamp (docker.io, github tags/releases), hold an update until
  // the highest already-soaked version passes minimumReleaseAge rather than
  // opening a PR for a still-pending release. Registries without a trusted
  // timestamp are handled separately in packageRules.json5 (timestamp-optional
  // + the pr-cooldown status check). See DevSecNinja/truenas-apps#115 and
  // docs/design-decisions/0005-pr-age-cooldown-for-untrusted-timestamps.md.
  internalChecksFilter: "strict",
  labels: ["dependencies"],
  osvVulnerabilityAlerts: true,
  timezone: 'Europe/Amsterdam',
  // One weekly window. Every Renovate run inside the window may push to an
  // open branch, and every push re-runs the repo's CI, so a single short
  // window (instead of Friday + the whole weekend) keeps the number of pushes
  // per week low. Automerge itself is not limited by this schedule: GitHub
  // merges as soon as the required checks pass. See
  // docs/design-decisions/0010-batch-renovate-updates-to-save-actions-minutes.md.
  schedule: [
    '* 0-7 * * 6',
  ],
  // Renovate only creates branches inside the schedule but, by default, keeps
  // updating existing ones at any time — an open weekly PR would still be
  // pushed (and its CI re-run) whenever a newer version clears the soak.
  // Manual rebase requests (PR checkbox, dashboard) are still honoured.
  updateNotScheduled: false,
  // Renovate's default, stated explicitly (ADR 0013). `auto` rebases a branch
  // that is behind the base branch only when that is needed for a safe merge:
  // automerge PRs, and repos that require branches to be up to date. In those
  // strict repos (the standard for public repos) automerged updates are always
  // tested against the latest base branch; elsewhere GitHub's native automerge
  // (platformAutomerge) may still merge a behind-base PR before Renovate gets
  // to rebase it. It also stops branch automerge (lock-file maintenance,
  // dotfiles devcontainer) from falling back to a PR when the base moves.
  // `conflicted` is "not recommended if you have enabled Renovate automerge"
  // (Renovate docs). The CI cost of rebasing is bounded by the weekly
  // all-non-major group, the Saturday-only schedule and
  // updateNotScheduled: false above, not by this setting. This includes the
  // docker-gated dependencies: their pr-cooldown soak survives rebases (ADR 0014).
  rebaseWhen: "auto",
  ignorePaths: [
    '**/*.sops.*',
  ],
  assigneesFromCodeOwners: true,
  reviewersFromCodeOwners: false,
  vulnerabilityAlerts: {
    labels: ["security"],
    minimumReleaseAge: "0",
    // Renovate's defaults already do this; stated explicitly because security
    // fixes must never be batched into the weekly non-major group
    // (groups.json5) or wait for the weekly schedule.
    groupName: null,
    schedule: ["at any time"],
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: "branch",
    addLabels: ["merge: auto"],
    commitMessageSuffix: "[automerge]",
    minimumReleaseAge: "0",
    // Monthly (first day of the month) instead of Renovate's weekly default:
    // a lock refresh rarely matters week to week, and each one costs a CI run.
    schedule: ["* 0-7 1 * *"],
    // Branch automerge is done by Renovate itself and is skipped outside the
    // schedule when updateNotScheduled is false; allow it here so a branch
    // whose checks finish after the window does not wait a month to merge.
    updateNotScheduled: true,
  },
  registryAliases: {
    "dhi.io": "dhi.io",
  },
  hostRules: [
    {
      matchHost: "dhi.io",
      hostType: "docker",
      username: "{{ secrets.MEND_DHI_USERNAME }}",
      password: "{{ secrets.MEND_DHI_PASSWORD }}",
    },
  ],
  // Temp until this is fixed: https://github.com/renovatebot/renovate/discussions/43562#discussioncomment-17269402
  allowedUnsafeExecutions: [
    "gradleWrapper",
    "mise",
  ],
}
