{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:best-practices",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  pinDigests: true,
  rangeStrategy: "pin",
  minimumReleaseAge: "14 days",
  labels: ["dependencies"],
  osvVulnerabilityAlerts: true,
  timezone: 'Europe/Amsterdam',
  schedule: [
    'every weekend',
    'on Friday',
  ],
  ignorePaths: [
    '**/*.sops.*',
  ],
  assigneesFromCodeOwners: true,
  reviewersFromCodeOwners: false,
  vulnerabilityAlerts: {
    labels: ["security"],
    minimumReleaseAge: "0",
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: "branch",
    addLabels: ["merge: auto"],
    commitMessageSuffix: "[automerge]",
    minimumReleaseAge: "0",
  },
  registryAliases: {
    "dhi.io": "dhi.io",
  },
  hostRules: [
    {
      matchHost: "dhi.io",
      hostType: "docker",
      username: "{{ secrets.MEND_DHI_USERNAME }}",
      password: "{{ secrets.MEND_DHI_PASSWORD }}",
    },
  ],
  // Temp until this is fixed: https://github.com/renovatebot/renovate/discussions/43562#discussioncomment-17269402
  allowedUnsafeExecutions: [
    "gradleWrapper",
    "mise",
  ],
}
